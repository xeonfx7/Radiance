{%- doc -%}
  Applies the Sloth Hiking Club-inspired product title metrics only to the
  Comfort Colors shirt template. This marker block is intentionally empty.
{%- enddoc -%}

<span
  class="rad_ccshirt_title_style"
  hidden
  aria-hidden="true"
  {{ block.shopify_attributes }}
></span>

<style>
  @font-face {
    font-family: 'RAD Barlow Condensed';
    src: url('{{ 'rad-barlow-condensed-800.ttf' | asset_url }}') format('truetype');
    font-style: normal;
    font-weight: 800;
    font-display: swap;
  }

  /* The product-details stack has a 28px block gap. The reference begins the
     title immediately after the breadcrumb's 26px-tall area. */
  .product-details:has(.rad_ccshirt_title_style) .rad_breadcrumbs--embedded {
    margin-block-end: -28px;
  }

  .product-details:has(.rad_ccshirt_title_style)
    .group-block-content
    > .group-block:has(> .group-block-content h1)
    > .group-block-content {
    --gap: 10px;
  }

  .product-details:has(.rad_ccshirt_title_style)
    .group-block-content
    > .group-block:has(> .group-block-content h1)
    .text-block:has(> h1),
  .product-details:has(.rad_ccshirt_title_style)
    .group-block-content
    > .group-block:has(> .group-block-content h1)
    .text-block:has(> h1)
    > h1 {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    font-size: 2.16rem;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: #173b2d;
  }

  .product-details:has(.rad_ccshirt_title_style)
    .group-block-content
    > .group-block:has(> .group-block-content h1)
    h1 {
    margin: 0;
  }

  /* The reference's related-products heading uses Barlow Condensed 800.
     Load that face only for this CC-shirt alternate-template heading; the
     rest of the storefront retains the configured theme fonts. */
  body:has(.rad_ccshirt_title_style)
    product-recommendations[data-testid='product-recommendations-section']
    .text-block:has(> h2)
    > h2 {
    margin: 0;
    color: #173b2d;
    font-family: 'RAD Barlow Condensed', 'Barlow Condensed', sans-serif;
    font-style: normal;
    font-size: clamp(1.75rem, 3.43vw, 3rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }

  .product-details:has(.rad_ccshirt_title_style)
    .group-block-content
    > .group-block:has(> .group-block-content h1)
    product-price
    [ref='priceContainer'] {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-family: var(--font-body--family);
  }

  .product-details:has(.rad_ccshirt_title_style)
    .group-block-content
    > .group-block:has(> .group-block-content h1)
    product-price
    .price {
    font-family: var(--font-body--family);
    font-size: 21px;
    font-weight: 500;
    line-height: 1.4;
  }

  .product-details:has(.rad_ccshirt_title_style)
    .group-block-content
    > .group-block:has(> .group-block-content h1)
    product-price
    .compare-at-price {
    color: var(--color-foreground);
    font-family: var(--font-body--family);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.5;
  }

  /* Horizon's product stack uses a 28px gap. The reference places the rating
     row 12px after the price, so reduce this one gap by 16px. */
  .product-details:has(.rad_ccshirt_title_style)
    .group-block-content
    > .group-block:has(> .group-block-content h1)
    + .rad_ccshirt_meta {
    margin-block-start: -16px;
  }

  @media screen and (max-width: 749px) {
    /* The mobile breadcrumb is visually hidden, but its wrapper remains a
       flex item and adds Horizon's 24px stack gap before the title. Remove
       that wrapper and set the desired 12px media-to-title separation. */
    .product-details:has(.rad_ccshirt_title_style) {
      padding-block-start: 12px;
    }

    .product-details:has(.rad_ccshirt_title_style)
      > .group-block
      > .group-block-content
      > div:has(.rad_breadcrumbs--embedded) {
      display: none;
    }

    .product-details:has(.rad_ccshirt_title_style)
      .group-block-content
      > .group-block:has(> .group-block-content h1)
      product-price
      [ref='priceContainer'] {
      gap: 8px;
      transform: translateY(5px);
    }

    .product-details:has(.rad_ccshirt_title_style)
      .group-block-content
      > .group-block:has(> .group-block-content h1)
      product-price
      .price {
      font-size: 16px;
      font-weight: 600;
      line-height: 1.4;
    }

    .product-details:has(.rad_ccshirt_title_style)
      .group-block-content
      > .group-block:has(> .group-block-content h1)
      product-price
      .compare-at-price {
      font-size: 13px;
      font-weight: 400;
      line-height: 1.4;
    }

    .product-details:has(.rad_ccshirt_title_style)
      .group-block-content
      > .group-block:has(> .group-block-content h1)
      > .group-block-content {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 12px;
      /* Keep the title, price, and reviews close together on mobile. */
      row-gap: 2px;
    }

    .product-details:has(.rad_ccshirt_title_style)
      .group-block-content
      > .group-block:has(> .group-block-content h1)
      > .group-block-content
      > :has(h1) {
      grid-column: 1 / -1;
    }

    .product-details:has(.rad_ccshirt_title_style)
      .group-block-content
      > .group-block:has(> .group-block-content h1)
      > .group-block-content
      > :has(product-price) {
      grid-column: 1;
      align-self: stretch;
      display: flex;
      align-items: center;
    }

    .product-details:has(.rad_ccshirt_title_style)
      .group-block-content
      > .group-block:has(> .group-block-content h1)
      > .group-block-content
      > .rad_ccshirt_meta {
      grid-column: 2;
      align-self: center;
    }

    .product-details:has(.rad_ccshirt_title_style)
      .group-block-content
      > .group-block:has(> .group-block-content h1)
      .text-block:has(> h1),
    .product-details:has(.rad_ccshirt_title_style)
      .group-block-content
      > .group-block:has(> .group-block-content h1)
      .text-block:has(> h1)
      > h1 {
      font-size: 25px;
      line-height: 1.15;
      letter-spacing: -0.025em;
    }
  }
</style>

{% schema %}
{
  "name": "RAD CC title style",
  "tag": null,
  "presets": [
    {
      "name": "RAD CC title style"
    }
  ]
}
{% endschema %}
