{%- doc -%}
  Ensures available Comfort Colors swatches show a pointer cursor.
{%- enddoc -%}

<span
  class="rad_ccshirt_swatch_cursor"
  hidden
  {{ block.shopify_attributes }}
></span>

{% stylesheet %}
  .product-details:has(.rad_ccshirt_swatch_cursor) .variant-option--swatches legend {
    display: flex;
    align-items: center;
    margin: 0 0 8px;
    font-family: var(--font-body--family);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.4;
  }

  @media screen and (max-width: 749px) {
    /* The title group and picker are siblings in Horizon's 28px product stack.
       The reference leaves 16px from the review row to the Color label. */
    .product-details:has(.rad_ccshirt_swatch_cursor)
      > .group-block
      > .group-block-content
      > .group-block:has(> .group-block-content h1)
      + variant-picker {
      margin-block-start: -20px;
    }

    .product-details:has(.rad_ccshirt_swatch_cursor) .variant-option--swatches legend {
      margin-block-end: 4px;
      font-size: 13px;
    }

    /* Match the reference palette: a 32px colour chip inside a 40px
       circular target, with the selected state drawn inside its boundary. */
    .product-details:has(.rad_ccshirt_swatch_cursor) .variant-option--swatches {
      column-gap: 10px;
      row-gap: 4px;
    }

    .product-details:has(.rad_ccshirt_swatch_cursor)
      .variant-option--swatches
      .variant-option__button-label--has-swatch,
    .product-details:has(.rad_ccshirt_swatch_cursor)
      .variant-option--swatches
      .variant-option__button-label--has-swatch
      .swatch {
      width: 40px;
      height: 40px;
    }

    .product-details:has(.rad_ccshirt_swatch_cursor)
      .variant-option--swatches
      .variant-option__button-label--has-swatch {
      overflow: visible;
      outline: none;
    }

    .product-details:has(.rad_ccshirt_swatch_cursor)
      .variant-option--swatches
      .variant-option__button-label--has-swatch
      .swatch {
      padding: 3px;
      border: 1px solid transparent;
      border-radius: 50%;
      background-clip: content-box;
      background-size: 32px 32px;
    }

    .product-details:has(.rad_ccshirt_swatch_cursor)
      .variant-option--swatches
      .variant-option__button-label--has-swatch:has(:checked)
      .swatch {
      border-color: #173b2d;
    }
  }

  .product-details:has(.rad_ccshirt_swatch_cursor) .variant-option--swatches .variant-option__swatch-value {
    padding-inline-start: 4px;
    color: inherit;
    font-family: var(--font-subheading--family);
    font-weight: var(--font-subheading--weight);
  }

  .product-details:has(.rad_ccshirt_swatch_cursor) .variant-option--swatches .variant-option__button-label,
  .product-details:has(.rad_ccshirt_swatch_cursor) .variant-option--swatches .variant-option__button-label * {
    cursor: pointer;
  }

  .product-details:has(.rad_ccshirt_swatch_cursor)
    .variant-option--swatches
    .variant-option__button-label:has([data-option-available='false']),
  .product-details:has(.rad_ccshirt_swatch_cursor)
    .variant-option--swatches
    .variant-option__button-label:has([data-option-available='false'])
    * {
    cursor: not-allowed;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RAD CC swatch cursor",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "RAD CC swatch cursor"
    }
  ]
}
{% endschema %}
