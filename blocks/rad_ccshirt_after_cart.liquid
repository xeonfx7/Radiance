{% liquid
  assign guarantee_text = block.settings.guarantee_text | default: 'Less than 1% of customers use our money back guarantee.'
  assign shipping_text = block.settings.shipping_text | default: 'Free shipping $85+'
  assign secure_text = block.settings.secure_text | default: 'Secure checkout'
  assign care_items = block.settings.care_items | newline_to_br | split: '<br />'
%}

<div
  class="rad_ccshirt_after_cart"
  {{ block.shopify_attributes }}
>
  <div class="rad_ccshirt_after_cart__guarantee">
    <span
      class="rad_ccshirt_after_cart__icon"
      aria-hidden="true"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        focusable="false"
      >
        <path d="M12 3.75 5.25 6.6v5.05c0 4.2 2.75 7.95 6.75 9.1 4-1.15 6.75-4.9 6.75-9.1V6.6L12 3.75Z" stroke="currentColor" stroke-width="1.5"/>
        <path d="m8.85 12.15 2.05 2.05 4.25-4.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
    <span>{{ guarantee_text }}</span>
  </div>

  <div class="rad_ccshirt_after_cart__meta">
    <div class="rad_ccshirt_after_cart__meta_item">
      <span
        class="rad_ccshirt_after_cart__icon"
        aria-hidden="true"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          focusable="false"
        >
          <path d="M3.75 6.75h10.5v9.5H3.75v-9.5Zm10.5 3.25h3.15l2.85 3v3.25h-6V10Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          <path d="M7.25 18.25a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Zm10 0a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z" stroke="currentColor" stroke-width="1.5"/>
        </svg>
      </span>
      <span>{{ shipping_text }}</span>
    </div>

    <div class="rad_ccshirt_after_cart__meta_item">
      <span
        class="rad_ccshirt_after_cart__icon"
        aria-hidden="true"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          focusable="false"
        >
          <path d="M7 10.25h10v8H7v-8Z" stroke="currentColor" stroke-width="1.5"/>
          <path d="M9 10.25V8a3 3 0 1 1 6 0v2.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </span>
      <span>{{ secure_text }}</span>
    </div>
  </div>

  <div class="rad_ccshirt_after_cart__accordions">
    <details
      class="rad_ccshirt_after_cart__details"
      open
    >
      <summary class="rad_ccshirt_after_cart__summary">
        <span>{{ block.settings.about_heading }}</span>
        <span
          class="rad_ccshirt_after_cart__toggle"
          aria-hidden="true"
        ></span>
      </summary>
      <div class="rad_ccshirt_after_cart__content">
        {{ block.settings.about_text }}
      </div>
    </details>

    <details class="rad_ccshirt_after_cart__details">
      <summary class="rad_ccshirt_after_cart__summary">
        <span>{{ block.settings.care_heading }}</span>
        <span
          class="rad_ccshirt_after_cart__toggle"
          aria-hidden="true"
        ></span>
      </summary>
      <div class="rad_ccshirt_after_cart__content">
        <ul>
          {% for care_item in care_items %}
            {% assign care_item = care_item | strip %}
            {% if care_item != blank %}
              <li>{{ care_item }}</li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    </details>

    <details class="rad_ccshirt_after_cart__details">
      <summary class="rad_ccshirt_after_cart__summary">
        <span>{{ block.settings.shipping_heading }}</span>
        <span
          class="rad_ccshirt_after_cart__toggle"
          aria-hidden="true"
        ></span>
      </summary>
      <div class="rad_ccshirt_after_cart__content">
        {{ block.settings.shipping_body }}
        <p class="rad_ccshirt_after_cart__policy_links">
          <a href="{{ block.settings.shipping_policy_link | default: '/policies/shipping-policy' }}">Shipping policy</a>
          <span aria-hidden="true"> · </span>
          <a href="{{ block.settings.refund_policy_link | default: '/policies/refund-policy' }}">Refund policy</a>
        </p>
      </div>
    </details>
  </div>

</div>

{% stylesheet %}
  .rad_ccshirt_after_cart {
    display: grid;
    gap: 18px;
    width: 100%;
    color: var(--color-foreground);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .rad_ccshirt_after_cart__guarantee {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    background: rgb(var(--color-foreground-rgb) / 0.045);
  }

  .rad_ccshirt_after_cart__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .rad_ccshirt_after_cart__meta_item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .rad_ccshirt_after_cart__icon {
    display: inline-flex;
    width: 22px;
    height: 22px;
    flex: 0 0 auto;
  }

  .rad_ccshirt_after_cart__icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .rad_ccshirt_after_cart__accordions {
    border-top: 1px solid var(--color-border);
  }

  .rad_ccshirt_after_cart__details {
    border-bottom: 1px solid var(--color-border);
  }

  .rad_ccshirt_after_cart__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 0;
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    list-style: none;
  }

  .rad_ccshirt_after_cart__summary::-webkit-details-marker {
    display: none;
  }

  .rad_ccshirt_after_cart__toggle {
    position: relative;
    width: 12px;
    height: 12px;
    flex: 0 0 auto;
  }

  .rad_ccshirt_after_cart__toggle::before,
  .rad_ccshirt_after_cart__toggle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transform: translateY(-50%);
  }

  .rad_ccshirt_after_cart__toggle::after {
    transform: translateY(-50%) rotate(90deg);
  }

  .rad_ccshirt_after_cart__details[open] .rad_ccshirt_after_cart__toggle::after {
    display: none;
  }

  .rad_ccshirt_after_cart__content {
    padding: 0 0 20px;
  }

  .rad_ccshirt_after_cart__content > :first-child {
    margin-top: 0;
  }

  .rad_ccshirt_after_cart__content > :last-child {
    margin-bottom: 0;
  }

  .rad_ccshirt_after_cart__content ul {
    margin: 14px 0 0;
    padding-left: 1.25em;
  }

  .rad_ccshirt_after_cart__content li + li {
    margin-top: 8px;
  }

  .rad_ccshirt_after_cart__policy_links a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  @media screen and (max-width: 749px) {
    .rad_ccshirt_after_cart__meta {
      align-items: flex-start;
      flex-direction: column;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RAD CC Shirt after cart",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee text",
      "default": "Less than 1% of customers use our money back guarantee."
    },
    {
      "type": "text",
      "id": "shipping_text",
      "label": "Shipping text",
      "default": "Free shipping $85+"
    },
    {
      "type": "text",
      "id": "secure_text",
      "label": "Secure text",
      "default": "Secure checkout"
    },
    {
      "type": "header",
      "content": "About accordion"
    },
    {
      "type": "text",
      "id": "about_heading",
      "label": "Heading",
      "default": "ABOUT THIS TEE"
    },
    {
      "type": "richtext",
      "id": "about_text",
      "label": "Text",
      "default": "<p>A soft spot for the slow lane. This Comfort Colors 1717 tee brings an easy, lived-in feel to slow hikes, snack stops, and days with no agenda.</p><ul><li>100% ring-spun cotton.</li><li>Heavier fabric, garment-dyed for soft color and a lived-in feel.</li><li>Relaxed unisex fit with room to take it easy.</li></ul>"
    },
    {
      "type": "header",
      "content": "Care accordion"
    },
    {
      "type": "text",
      "id": "care_heading",
      "label": "Heading",
      "default": "KEEP IT LOOKING GOOD"
    },
    {
      "type": "textarea",
      "id": "care_items",
      "label": "Care items",
      "default": "Machine wash cold, inside out.\nTumble dry low or hang dry.\nSkip the bleach and keep the iron off the print."
    },
    {
      "type": "header",
      "content": "Shipping accordion"
    },
    {
      "type": "text",
      "id": "shipping_heading",
      "label": "Heading",
      "default": "SHIPPING & RETURNS"
    },
    {
      "type": "richtext",
      "id": "shipping_body",
      "label": "Text",
      "default": "<p>Orders ship within 3-5 days. Allow another 3-5 days after dispatch for delivery. Orders over $85 qualify for free shipping.</p>"
    },
    {
      "type": "url",
      "id": "shipping_policy_link",
      "label": "Shipping policy link"
    },
    {
      "type": "url",
      "id": "refund_policy_link",
      "label": "Refund policy link"
    },
  ],
  "presets": [
    {
      "name": "RAD CC Shirt after cart"
    }
  ]
}
{% endschema %}
