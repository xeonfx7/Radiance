{%- doc -%}
  Hides the add-to-cart icon for the Comfort Colors product template only.
{%- enddoc -%}

<span
  class="rad_ccshirt_add_to_cart_icon"
  hidden
  {{ block.shopify_attributes }}
></span>

{% stylesheet %}
  .product-details:has(.rad_ccshirt_add_to_cart_icon) .add-to-cart-icon {
    display: none;
  }

  .product-details:has(.rad_ccshirt_add_to_cart_icon) .add-to-cart-button {
    height: 54px;
    padding: 13px 15px;
    font-family: var(--font-body--family);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: normal;
    text-transform: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RAD CC add-to-cart icon",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "RAD CC add-to-cart icon"
    }
  ]
}
{% endschema %}
